Options -Indexes
ErrorDocument 404 /404.php
DirectoryIndex index.php
ServerSignature Off

RewriteEngine On

# HTTPS obligatoire
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://inspectiondronefrance.fr%{REQUEST_URI} [L,R=301]

# www -> sans www
RewriteCond %{HTTP_HOST} ^www\.inspectiondronefrance\.fr$ [NC]
RewriteRule ^ https://inspectiondronefrance.fr%{REQUEST_URI} [L,R=301]

# /index.php -> /
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ https://inspectiondronefrance.fr/ [L,R=301]

# robots.txt et sitemap.xml générés en PHP
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Pas d'accès direct aux fichiers internes
RewriteRule ^includes/ - [F,L]
RewriteRule (^|/)\.(git|env|ht) - [F,L]
RewriteRule \.(md|log|sql|bak|ini)$ - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>
